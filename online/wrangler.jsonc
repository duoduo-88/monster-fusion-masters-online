{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monster-fusion-masters-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "RoomDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RoomDirectory"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
